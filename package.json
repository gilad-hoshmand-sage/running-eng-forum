{
  "name": "eng-forum",
  "private": true,
  "description": "Engineering forum planning documents and the demo game",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "npm run dev --workspace apps/game --",
    "build": "npm run build --workspace apps/game --",
    "preview": "npm run preview --workspace apps/game --",
    "test": "npm run test --workspace apps/game --",
    "serve:python": "python3 -m http.server 8081 --bind 127.0.0.1 --directory apps/game/dist",
    "serve:nginx": "docker compose -f infra/static/compose.yaml up"
  }
}
